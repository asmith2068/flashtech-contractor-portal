# ─── Local development ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill it in.
#
# Set these two and `npm run dev` serves the api/ functions locally, isolated
# from production. Leave them blank and dev falls back to the DEPLOYED function,
# which means you are working against the LIVE customer database (the app shows
# a red warning bar when that happens).
#
# Point them at a SEPARATE staging Supabase project, not the production one.
# See README → "Local development" for the 15-minute setup.

SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=YOUR-STAGING-SERVICE-ROLE-KEY
SESSION_SECRET=any-long-random-string-for-signing-session-tokens

# ─── Optional ────────────────────────────────────────────────────────────────
# Without these, email silently no-ops and photo identification is disabled.
# RESEND_API_KEY=
# EMAIL_FROM=Flash-Tech Portal <onboarding@resend.dev>
# ANTHROPIC_API_KEY=

# ─── Deprecated ──────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are no longer used. The browser
# never talks to Supabase directly — everything goes through /api/portal.
